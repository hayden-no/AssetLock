.asset-lock-browser {
    flex-grow: 1;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 8px;
}

.asset-lock-browser.dark {
    background-color: rgb(37, 39, 43);
}

.asset-lock-browser.light {
    background-color: rgb(219, 221, 224);
}

.header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.heading {
    flex-grow: 1;
}

#browser-title {
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.subtitle {
    opacity: 0.72;
    margin-top: 2px;
}

.status-chip {
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 10px;
    background-color: rgb(112, 91, 56);
    color: rgb(255, 239, 209);
}

.status-chip.ready {
    background-color: rgb(36, 100, 79);
    color: rgb(222, 255, 237);
}

.settings-row, .action-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.settings-row {
    margin-bottom: 8px;
}

.settings-row Toggle {
    margin-right: 16px;
}

.summary {
    padding: 10px;
    margin-bottom: 8px;
    border-radius: 4px;
}

.dark .summary {
    background-color: rgb(49, 53, 59);
}

.light .summary {
    background-color: rgb(239, 241, 243);
}

.section-label {
    font-size: 10px;
    -unity-font-style: bold;
    opacity: 0.7;
    letter-spacing: 0.5px;
}

.counts {
    font-size: 13px;
    margin-top: 5px;
    -unity-font-style: bold;
}

.username {
    font-size: 13px;
    margin-top: 5px;
    -unity-font-style: bold;
}

.action-row {
    margin-bottom: 6px;
}

.action-button {
    margin-right: 4px;
}

.search-toolbar {
    margin-top: 4px;
    margin-bottom: 3px;
}

.search-toolbar Toggle {
    margin-left: 8px;
    margin-right: 4px;
}

.column-header {
    flex-direction: row;
    padding-left: 9px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-size: 10px;
    opacity: 0.7;
    -unity-font-style: bold;
}

.asset-column {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 90px;
}

.state-column {
    width: 120px;
    min-width: 90px;
    overflow: hidden;
}

.lock-list {
    flex-grow: 1;
    min-height: 60px;
}

.asset-row {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding-left: 8px;
    padding-right: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.18);
}

.asset-name {
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.asset-path {
    font-size: 10px;
    opacity: 0.7;
    overflow: hidden;
    white-space: nowrap;
}

.state-column.owned {
    color: rgb(78, 177, 141);
}

.state-column.other {
    color: rgb(215, 125, 105);
}

.light .state-column.owned {
    color: rgb(25, 100, 73);
}

.light .state-column.other {
    color: rgb(154, 63, 47);
}

.row-actions {
    width: 145px;
    flex-direction: row;
    justify-content: flex-end;
}

.row-actions Button {
    margin-left: 2px;
}

.empty-state {
    flex-grow: 1;
    -unity-text-align: middle-center;
    padding: 18px;
    opacity: 0.75;
    white-space: normal;
}

.message {
    color: rgb(214, 143, 88);
    white-space: normal;
}
